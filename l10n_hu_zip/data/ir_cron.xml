<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- noupdate: an update of the module must not deactivate a relink in progress -->
    <record id="ir_cron_relink_partners" model="ir.cron">
        <field name="name">Hungary: link contacts to the city of their ZIP</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="state">code</field>
        <field name="code">model._cron_l10n_hu_relink_partners()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False" />
    </record>
</odoo>
